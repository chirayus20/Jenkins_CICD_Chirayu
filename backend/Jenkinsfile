pipeline {
    agent any

    environment {
        APP_DIR = 'backend'
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Install Python Dependencies') {
            steps {
                sh '''
                    cd ${APP_DIR}
                    if [ ! -d "venv" ]; then
                        python3 -m venv venv
                    fi
                    . venv/bin/activate
                    pip install --upgrade pip
                    pip install -r requirements.txt
                '''
            }
        }

        stage('Deploy Backend (PM2)') {
            steps {
                sh '''
                    pm2 stop flask-backend || true
                    pm2 delete flask-backend || true

                    cd ${APP_DIR}
                    pm2 start venv/bin/python --name "flask-backend" -- app.py
                    pm2 save
                '''
            }
        }

        stage('Verify Health') {
            steps {
                sh '''
                    sleep 5
                    pm2 status
                    pm2 logs flask-backend --lines 15 --nostream
                    curl -f http://localhost:9000/health || exit 1
                '''
            }
        }
    }
}