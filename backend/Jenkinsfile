pipeline {
    agent any

    environment {
        // Backend folder name
        APP_DIR = 'backend'
    }

    stages {
        stage('Checkout Code') {
            steps {
                // Pull source code from GitHub
                checkout scm
            }
        }

        stage('Install Python Dependencies') {
            steps {
                sh '''
                    # Move to backend folder
                    cd ${APP_DIR}

                    # Create virtual environment if missing
                    if [ ! -d "venv" ]; then
                        python3 -m venv venv
                    fi

                    # Activate virtual environment and install requirements
                    . venv/bin/activate
                    pip install --upgrade pip
                    pip install -r requirements.txt
                '''
            }
        }

        stage('Deploy Backend (PM2)') {
            steps {
                sh '''
                    # Stop and remove existing Flask process if running
                    pm2 stop flask-backend || true
                    pm2 delete flask-backend || true

                    # Launch Flask API on port 9000 using PM2
                    pm2 start ${APP_DIR}/venv/bin/python --name "flask-backend" -- ${APP_DIR}/app.py
                    pm2 save
                '''
            }
        }

        stage('Verify Health') {
            steps {
                sh '''
                    # Wait for backend initialization
                    sleep 3

                    # Validate local endpoint on port 9000
                    curl -f http://localhost:9000/health || exit 1
                '''
            }
        }
    }
}